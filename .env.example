MYSQL_DATABASE=shiftrhythm
MYSQL_USER=shiftrhythm
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3307
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ISSUER=shiftrhythm-api
# 32 bytes or more, Base64-encoded
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Document AI (기본값은 팀 공용 프로세서. 필요 시 재정의)
