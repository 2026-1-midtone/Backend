MYSQL_DATABASE=shiftrhythm
MYSQL_USER=shiftrhythm
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3307
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ISSUER=shiftrhythm-api
# 32 bytes or more, Base64-encoded
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
# Document AI (기본값은 팀 공용 프로세서. 필요 시 재정의)
# DOCUMENTAI_PROJECT_NUMBER=437332095325
# DOCUMENTAI_LOCATION=us
# DOCUMENTAI_PROCESSOR_ID=cbb47f2525db9dc0
# 호스트 gcloud 설정 디렉터리 (Windows 기본: %APPDATA%/gcloud, Linux/macOS: ~/.config/gcloud)
# GCLOUD_CONFIG_DIR=~/.config/gcloud
# AI chatbot
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# 근무표 원본 이미지를 OpenAI OCR 폴백으로 전송할 때만 명시적으로 true
OPENAI_OCR_ENABLED=false
